{
  "name": "runda-tss-tech-club",
  "private": true,
  "version": "0.1.0",
  "description": "Secure offline exam system for RUNDA TSS TVET schools with anti-cheat and fullscreen lockdown.",
  "author": "RUNDA TSS Tech Club <support@runda-tss.rw>",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build && node scripts/copy-standalone-assets.js",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "seed": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "sync": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/sync.ts",
    "parse-curriculum": ".venv/bin/python scripts/parse-all-curriculum.py",
    "generate": "npx ts-node --compiler-options '{\"module\":\"CommonJS\",\"esModuleInterop\":true}' scripts/ai-content-generator-FREE.ts",
    "seed-content": "npx ts-node --compiler-options '{\"module\":\"CommonJS\",\"esModuleInterop\":true}' scripts/batch-content-seeder.ts",
    "smart-generate": "npx ts-node --compiler-options '{\"module\":\"CommonJS\",\"esModuleInterop\":true}' scripts/smart-content-generator.ts",
    "premium-generate": "npx ts-node --compiler-options '{\"module\":\"CommonJS\",\"esModuleInterop\":true}' scripts/premium-content-generator.ts",
    "hierarchical-generate": "npx ts-node --compiler-options '{\"module\":\"CommonJS\",\"esModuleInterop\":true}' scripts/premium-content-generator-hierarchical.ts",
    "curriculum-ai": "npx ts-node --compiler-options '{\"module\":\"CommonJS\",\"esModuleInterop\":true}' scripts/curriculum-ai.ts",
    "import-curriculums": "npx ts-node --compiler-options '{\"module\":\"CommonJS\",\"esModuleInterop\":true}' scripts/import-all-curriculums.ts",
    "simple-seed": "npx ts-node --compiler-options '{\"module\":\"CommonJS\",\"esModuleInterop\":true}' scripts/simple-content-seeder.ts",
    "electron": "electron electron/main.js",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3001 && electron electron/main.js\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:win-portable": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:all": "npm run build && electron-builder --win --linux --mac"
  },
  "desktopName": "RUNDA TSS Exam System",
  "prisma": {
    "seed": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@livekit/components-react": "^2.9.23",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/glob": "^8.1.0",
    "bcryptjs": "^3.0.3",
    "canvas": "^3.2.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "electron-store": "^10.1.0",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^11.0.0",
    "glob": "^13.0.6",
    "groq-sdk": "^1.5.0",
    "html2pdf.js": "^0.14.0",
    "i18next": "^26.4.0",
    "json5": "^2.2.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.12.1",
    "next": "14.2.5",
    "next-i18next": "^16.0.11",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.3.289",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-dropzone": "19.2.0",
    "react-i18next": "^17.0.12",
    "react-pdf": "^10.5.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/emoji-mart": "^3.0.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "fs-extra": "^11.4.0",
    "prettier": "^3.6.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "wait-on": "^9.1.0"
  },
  "main": "electron/main.js"
}